Circuit distribution_matrix {
    Parallel {
        Branch Supply {
            DCSource V_supply (+|-, 18, kilo)
        },
        Branch SurgeCapacitor {
            Capacitor C_surge (+|-, 220, micro)
        },
        Branch SurgeInductor {
            Inductor L_surge (4.7, milli)
        }
    },
    Parallel {
        Branch Isolation {
            Resistor R_iso (Regular, 100, kilo)
        },
        Branch LoadA {
            Resistor R_load1 (Regular, 470, base)
        },
        Branch LoadB {
            Resistor R_load2 (Regular, 470, base)
        }
    },
    Parallel {
        Branch SensorMeter {
            Voltmeter VM_A
        },
        Branch SensorFeed {
            DCSource SignalA (+|-, 0.6, base)
        },
        Branch SensorCurrent {
            Ammeter AM_B
        }
    },
    Parallel {
        Branch ControlMaster {
            Switch SW_master (Open)
        },
        Branch ControlOverride {
            Switch SW_override (Closed)
        }
    }
}