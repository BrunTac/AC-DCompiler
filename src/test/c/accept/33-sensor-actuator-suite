Circuit sensor_hub {
    Parallel {
        Branch Input {
            DCSource V_in (4.8, base)
        },
        Branch Monitor {
            Voltmeter V_mon,
            Resistor R_mon (Regular, 1, kilo)
        }
    },
    Resistor R_shunt (Regular, 10, base),
    Capacitor C_filter (+|-, 33, micro)
},
Circuit actuator_array {
    ACSource Source_main (1.5e+2+3.5e+1i, kilo),
    Parallel {
        Branch Motor {
            Switch SW_motor (Closed),
            Inductor L_motor (0.35, base)
        },
        Branch Brake {
            Resistor R_brake (Thermistor, 5, kilo)
        },
        Branch Sense {
            Ammeter A_feedback,
            Capacitor C_feedback (+|-, 10, micro)
        }
    }
}