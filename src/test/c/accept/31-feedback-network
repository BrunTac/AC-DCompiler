Circuit feedback_network {
    DCSource Vref (+|-, 5, base),
    Parallel {
        Branch SenseResistor {
            Resistor R_sense (Potentiometer, 2.2, kilo)
        },
        Branch SenseCapacitor {
            Capacitor C_sense (+|-, 47, nano)
        }
    },
    Parallel {
        Branch GainSource {
            DCSource Vin (+|-, 2, base)
        },
        Branch GainInductor {
            Inductor L_gain (15, milli)
        }
    },
    Parallel {
        Branch GateControl {
            Switch GateSwitch (Closed)
        },
        Branch VoltageMonitor {
            Voltmeter Vm_output
        },
        Branch CurrentFeedback {
            Ammeter Ia_feedback
        }
    }
}