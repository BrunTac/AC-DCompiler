Circuit signal_routing {
    ACSource Source_in (8.5e-1+2.2e-2j, base),
    Parallel {
        Branch SplitA {
            Resistor R_a (Regular, 330, base),
            Parallel {
                Branch AHigh {
                    Capacitor C_a (+|-, 12, micro)
                },
                Branch ALow {
                    Resistor R_trim (Potentiometer, 2.5, kilo),
                    Inductor L_a (3.3, milli)
                }
            }
        },
        Branch SplitB {
            Switch SW_gate (Closed),
            Parallel {
                Branch BSense {
                    Voltmeter VM_b,
                    Resistor R_sense (Photoresistor)
                },
                Branch BShunt {
                    DCSource Bias (+|-, 2.5, base)
                }
            }
        }
    },
    Amperemeter IA_monitor
}